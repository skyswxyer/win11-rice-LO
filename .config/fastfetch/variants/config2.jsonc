{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    	"source": "~/.config/fastfetch/logo/ascii.txt",
    	"type": "file", // kitty | file
      	"height":  15,
      	"padding": {
    		"top":  1
      	}
    },
        "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "key": "",
            "format": "{user-name}@{host-name}",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": "├",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "├󰏖",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "├󰅐",
            "format": "",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "└",
            "folders": "/",                                   
            "format": "{days} days",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "wm",
            "key": "",
            "keyColor": "yellow"
        },
        {
            "type": "lm",
            "key": "├󰧨",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "├",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "host",
            "key": "󰌢",
            "keyColor": "green"
        },
              {
            "type": "display",
            "key": "├󰍹",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "├",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "└󰑭",
            "keyColor": "green"
        },
        "break"
    ]
}
